# ============================================================================
# sfnxt-ctfl-starter - Configuration
# ============================================================================
# Copy to .env and fill in the values: `cp .env.default .env`
#
# This storefront renders from Contentful (Demo 2.0 content model) and makes no
# Salesforce Commerce calls. Every other setting has a default in
# config.server.base.ts / config.server.ts.
#
#   - Contentful setup:      docs/README-CONTENTFUL.md
#   - Content model:         docs/README-DEMO-2.0-CONTENT-MODEL.md
#   - Full config reference: docs/README-CONFIG.md
# ============================================================================

# ----------------------------------------------------------------------------
# Contentful (REQUIRED)
# Tokens for the `brand` space in config.server.base.ts (app.contentful.spaces.brand).
# Without the delivery token the storefront boots but renders no content.
# ----------------------------------------------------------------------------
CONTENTFUL_BRAND_DELIVERY_TOKEN=

# Preview only: drafts + Live Preview inspector. Leave empty to disable preview.
CONTENTFUL_BRAND_PREVIEW_TOKEN=
# Shared secret for ?cfpreview=<secret>. Must match the Contentful content preview URLs.
CONTENTFUL_PREVIEW_SECRET=

# ----------------------------------------------------------------------------
# Contentful Personalization (Ninetailed). Public: the browser SDK needs both.
# Personalization is inert while these are empty.
# ----------------------------------------------------------------------------
PUBLIC__app__personalization__clientId=
PUBLIC__app__personalization__environment=main

# ----------------------------------------------------------------------------
# Salesforce (not used by this storefront)
# Commerce routes and middlewares are disconnected (see docs/README-CONTENTFUL.md).
# Uncomment these when you reconnect them.
# ----------------------------------------------------------------------------
# PUBLIC__app__commerce__api__clientId=
# PUBLIC__app__commerce__api__organizationId=
# PUBLIC__app__commerce__api__shortCode=
# PUBLIC__app__commerce__api__privateKeyEnabled=false

# Managed Runtime (only read by `pnpm push`).
# MRT_PROJECT=
# MRT_ENVIRONMENT=
# MRT_API_KEY=
